{
  "name": "jlpt-n2-study",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "notes:consolidate": "node scripts/consolidate-n2-notes.mjs",
    "vocab:build": "node scripts/build-vocabulary-catalog.mjs",
    "audio:engine:up": "bash scripts/audio/engine.sh up cpu",
    "audio:engine:up:nvidia": "bash scripts/audio/engine.sh up nvidia",
    "audio:engine:down": "bash scripts/audio/engine.sh down",
    "audio:engine:status": "bash scripts/audio/engine.sh status",
    "audio:engine:logs": "bash scripts/audio/engine.sh logs",
    "audio:engine:wait": "bash scripts/audio/engine.sh wait",
    "audio:engine:bootstrap-bert": "bash scripts/audio/bootstrap-bert-cache.sh",
    "audio:voices:install": "node scripts/audio/install-voices.mjs",
    "audio:voices:list": "node scripts/audio/list-voices.mjs",
    "audio:dictionary:sync": "node scripts/audio/sync-dictionary.mjs",
    "audio:generate": "node scripts/audio/generate.mjs",
    "audio:benchmark": "node scripts/audio/generate.mjs --scope benchmark"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "JLPT N2 Study Atlas"
}
