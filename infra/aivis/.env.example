# Copy to .env only when overriding defaults. Do not commit machine-specific paths.
AIVIS_PORT=10101
AIVIS_DATA_DIR=/absolute/path/to/.local/share/AivisSpeech-Engine
AIVIS_CPU_IMAGE=ghcr.io/aivis-project/aivisspeech-engine:cpu-latest
AIVIS_NVIDIA_IMAGE=ghcr.io/aivis-project/aivisspeech-engine:nvidia-latest
# Optional in regions where huggingface.co is not directly reachable:
# AIVIS_HF_ENDPOINT=https://hf-mirror.com
# AIVIS_HF_HUB_OFFLINE=1
